# syntax=docker/dockerfile:1.7
# Optional runtime for an independently cloned upstream FoundationPose checkout.
# Build context: upstream FoundationPose root. No ROS, ZED, or segmentation.
FROM nvidia/cuda:13.0.2-devel-ubuntu22.04
ARG FP_CUDA_ARCH=12.0
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=${FP_CUDA_ARCH} \
    MAX_JOBS=4 FORCE_CUDA=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    PYOPENGL_PLATFORM=egl OPENCV_IO_ENABLE_OPENEXR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip python-is-python3 git ca-certificates \
    build-essential cmake ninja-build libboost-system-dev libboost-program-options-dev \
    libeigen3-dev libgl1 libegl1 libglib2.0-0 libgomp1 libglvnd0 libglx0 \
    libxrender1 libsm6 libxext6 libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel ninja \
    && python -m pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 \
       --index-url https://download.pytorch.org/whl/cu130 \
    && python -c "import importlib.metadata as m; open('/opt/fp-constraints.txt','w').write('\n'.join(p+'=='+m.version(p) for p in ('torch','torchvision'))+'\nnumpy==2.2.6\npybind11==2.13.6\n')"
ENV PIP_CONSTRAINT=/opt/fp-constraints.txt
COPY requirements.txt /tmp/fp-requirements.txt
RUN python -m pip install --no-cache-dir numpy==2.2.6 pybind11==2.13.6 \
    && python -m pip install --no-cache-dir -r /tmp/fp-requirements.txt \
    && python -m pip install --no-cache-dir --no-build-isolation \
       git+https://github.com/facebookresearch/pytorch3d.git@978cd99221b9e0a6a568f1d427854d73363265cf \
       git+https://github.com/NVlabs/nvdiffrast.git@253ac4fcea7de5f396371124af597e6cc957bfae \
    && python -m pip check
WORKDIR /workspace/FoundationPose
CMD ["bash"]
