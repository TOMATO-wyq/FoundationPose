# CUDA 13.0 migration. Actual build and GPU validation are required.
FROM nvidia/cuda:13.0.2-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="12.0" \
    MAX_JOBS=4 \
    FORCE_CUDA=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    PYOPENGL_PLATFORM=egl \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip python-is-python3 git ca-certificates \
    build-essential cmake ninja-build libboost-system-dev libboost-program-options-dev \
    libeigen3-dev pybind11-dev libgl1 libegl1 libglib2.0-0 libgomp1 \
    libglvnd0 libglx0 libxrender1 libsm6 libxext6 libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip setuptools wheel ninja \
    && python -m pip install torch==2.9.1 torchvision==0.24.1 \
       --index-url https://download.pytorch.org/whl/cu130
COPY requirements.txt /tmp/foundationpose-requirements.txt
COPY docker/constraints-cu130.txt /opt/constraints-cu130.txt
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_CONSTRAINT=/opt/constraints-cu130.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url "${PIP_INDEX_URL}" six==1.17.0
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url "${PIP_INDEX_URL}" -r /tmp/foundationpose-requirements.txt
ARG PYTORCH3D_REF=978cd99221b9e0a6a568f1d427854d73363265cf
ARG NVDIFFRAST_REF=253ac4fcea7de5f396371124af597e6cc957bfae
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url "${PIP_INDEX_URL}" --no-build-isolation \
    "git+https://github.com/facebookresearch/pytorch3d.git@${PYTORCH3D_REF}" \
    "git+https://github.com/NVlabs/nvdiffrast.git@${NVDIFFRAST_REF}"
RUN python -m pip check \
    && python -c "import torch, open3d; assert torch.version.cuda == '13.0'; print(torch.__version__, open3d.__version__)" \
    && python -m pip freeze > /opt/foundationpose-packages.txt
# Ubuntu 22.04 ships pybind11 2.9.1; extensions compiled against NumPy 2
# need pybind11 >= 2.12 for its updated NumPy API support.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url "${PIP_INDEX_URL}" pybind11==2.13.6
WORKDIR /workspace/FoundationPose
CMD ["bash"]
