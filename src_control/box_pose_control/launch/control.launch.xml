<launch>
  <arg name="params_file" default="$(find-pkg-share box_pose_control)/config/control.yaml"/>
  <arg name="dry_run" default="true"/>
  <arg name="size" default="big"/>
  <arg name="target_distance_m" default="0.30"/>
  <arg name="target_lateral_m" default="0.0"/>
  <arg name="serial_port" default="/dev/ttyUSB0"/>
  <node pkg="box_pose_control" exec="box_pose_control_node" name="box_pose_control" output="screen">
    <param from="$(var params_file)"/>
    <param name="dry_run" value="$(var dry_run)"/>
    <param name="size" value="$(var size)"/>
    <param name="target_distance_m" value="$(var target_distance_m)"/>
    <param name="target_lateral_m" value="$(var target_lateral_m)"/>
    <param name="serial_port" value="$(var serial_port)"/>
  </node>
</launch>
